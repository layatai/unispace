# Copy to scripts/.ship.env (gitignored) and fill in to enable notarization.
# scripts/ship.sh sources this automatically.

# --- Apple ID method ---
APPLE_ID="you@example.com"
APPLE_PASSWORD="abcd-efgh-ijkl-mnop"   # app-specific password (appleid.apple.com → Sign-In & Security)
APPLE_TEAM_ID="Y69F3DRK44"             # TUYEN HO

# --- or App Store Connect API key method (leave the above blank if using this) ---
# APPLE_API_KEY_PATH="/path/to/AuthKey_XXXXXX.p8"
# APPLE_API_KEY="XXXXXX"               # Key ID
# APPLE_API_ISSUER="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# --- optional: pin the signing identity (else first "Developer ID Application" is used) ---
# APPLE_SIGNING_IDENTITY="Developer ID Application: TUYEN HO (Y69F3DRK44)"

# --- optional: local speed-up mode (set to 1 for faster iterative notarized builds) ---
# SHIP_FAST=1

